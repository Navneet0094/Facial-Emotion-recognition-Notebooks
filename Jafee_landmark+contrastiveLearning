sk\"\n","MODEL_URL = (\"https://storage.googleapis.com/mediapipe-models/face_landmarker/\"\n","             \"face_landmarker/float16/1/face_landmarker.task\")\n","\n","if not os.path.exists(MODEL_PATH):\n","    urllib.request.urlretrieve(MODEL_URL, MODEL_PATH)\n","    print(\"Downloaded face landmarker model.\")\n","else:\n","    print(\"Model already present.\")\n","\n","landmarker_options = vision.FaceLandmarkerOptions(\n","    base_options=BaseOptions(model_asset_path=MODEL_PATH),\n","    num_faces=1,\n","    min_face_detection_confidence=0.3,\n",")\n","face_landmarker = vision.FaceLandmarker.create_from_options(landmarker_options)\n","\n","# stable landmark indices (same topology as classic FaceMesh: 0-467, plus iris points)\n","LEFT_EYE_CORNER = 33\n","RIGHT_EYE_CORNER = 263\n","\n","def get_landmarks(rgb_image):\n","    \"\"\"Returns an (N, 2) array of pixel-coordinate landmarks, or None if no face found.\"\"\"\n","    h, w = rgb_image.shape[:2]\n","    mp_image = mp.Image(image_format=mp.ImageFormat.SRGB, data=rgb_image)\n","    result = face_landmarker.detect(mp_image)\n","    if not result.face_landmarks:\n","        return None\n","    pts = result.face_landmarks[0]\n","    coords = np.array([[p.x * w, p.y * h] for p in pts])\n","    return coords\n","\n","all_landmarks = []\n","valid_idx = []\n","\n","for i, img in enumerate(raw_images):\n","    lm = get_landmarks(img)\n","    if lm is not None:\n","        all_landmarks.append(lm)\n","        valid_idx.append(i)\n","\n","print(f\"Landmarks detected for {len(valid_idx)}/{len(raw_images)} images\")\n","\n","# keep only the images where a face was found\n","raw_images = [raw_images[i] for i in valid_idx]\n","labels = labels[valid_idx]\n","subjects = subjects[valid_idx]\n","landmarks_list = all_landmarks\n"]},{"cell_type":"code","execution_count":7,"id":"9ba43934","metadata":{"execution":{"iopub.execute_input":"2026-09-03T10:22:31.692008Z","iopub.status.busy":"2026-09-03T10:22:31.691694Z","iopub.status.idle":"2026-09-03T10:22:32.101947Z","shell.execute_reply":"2026-09-03T10:22:32.100688Z"},"papermill":{"duration":0.427904,"end_time":"2026-09-03T10:22:32.109027+00:00","exception":false,"start_time":"2026-09-03T10:22:31.681123+00:00","status":"completed"},"tags":[]},"outputs":[{"data":{"image/png":"\n","text/plain":["<Figure size 1200x300 with 5 Axes>"]},"metadata":{},"output_type":"display_data"}],"source":["# visualize landmarks on a few samples\n","plt.figure(figsize=(12, 3))\n","for i in range(5):\n","    plt.subplot(1, 5, i + 1)\n","    plt.imshow(raw_images[i])\n","    lm = landmarks_list[i]\n","    plt.scatter(lm[:, 0], lm[:, 1], s=2, c='lime')\n","    plt.title(emotion_names[labels[i]])\n","    plt.axis('off')\n","plt.suptitle(\"Detected face landmarks\")\n","plt.tight_layout()\n","plt.show()\n"]},{"cell_type":"code","execution_count":8,"id":"79432980","metadata":{"execution":{"iopub.execute_input":"2026-09-03T10:22:32.139293Z","iopub.status.busy":"2026-09-03T10:22:32.138944Z","iopub.status.idle":"2026-09-03T10:22:32.31851Z","shell.execute_reply":"2026-09-03T10:22:32.317579Z"},"papermill":{"duration":0.196424,"end_time":"2026-09-03T10:22:32.320199+00:00","exception":false,"start_time":"2026-09-03T10:22:32.123775+00:00","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["Aligned faces shape: (213, 128, 128, 3)\n"]}],"source":["OUT_SIZE = 128\n","\n","def align_and_crop(rgb_image, landmarks, out_size=OUT_SIZE, margin=0.25):\n","    left_eye = landmarks[LEFT_EYE_CORNER]\n","    right_eye = landmarks[RIGHT_EYE_CORNER]\n","\n","    # angle needed to make the eye line horizontal\n","    dy = right_eye[1] - left_eye[1]\n","    dx = right_eye[0] - left_eye[0]\n","    angle = np.degrees(np.arctan2(dy, dx))\n","\n","    h, w = rgb_image.shape[:2]\n","    center = (w // 2, h // 2)\n","    rot_matrix = cv2.getRotationMatrix2D(center, angle, 1.0)\n","\n","    rotated_img = cv2.warpAffine(rgb_image, rot_matrix, (w, h))\n","\n","    # rotate the landmarks the same way, so the crop box matches the rotated face\n","    ones = np.ones((landmarks.shape[0], 1))\n","    lm_hom = np.hstack([landmarks, ones])\n","    rotated_lm = (rot_matrix @ lm_hom.T).T\n","\n","    x_min, y_min = rotated_lm.min(axis=0)\n","    x_max, y_max = rotated_lm.max(axis=0)\n","\n","    box_w = x_max - x_min\n","    box_h = y_max - y_min\n","    x_min -= margin * box_w\n","    x_max += margin * box_w\n","    y_min -= margin * box_h\n","    y_max += margin * box_h\n","\n","    x_min, y_min = max(0, int(x_min)), max(0, int(y_min))\n","    x_max, y_max = min(w, int(x_max)), min(h, int(y_max))\n","\n","    face_crop = rotated_img[y_min:y_max, x_min:x_max]\n","    face_crop = cv2.resize(face_crop, (out_size, out_size))\n","    return face_crop\n","\n","aligned_faces = []\n","for img, lm in zip(raw_images, landmarks_list):\n","    aligned_faces.append(align_and_crop(img, lm))\n","\n","aligned_faces = np.array(aligned_faces)\n","print(\"Aligned faces shape:\", aligned_faces.shape)\n"]},{"cell_type":"code","execution_count":9,"id":"89e9023a","metadata":{"execution":{"iopub.execute_input":"2026-09-03T10:22:32.348655Z","iopub.status.busy":"2026-09-03T10:22:32.348352Z","iopub.status.idle":"2026-09-03T10:22:32.984504Z","shell.execute_reply":"2026-09-03T10:22:32.983687Z"},"papermill":{"duration":0.659415,"end_time":"2026-09-03T10:22:32.993357+00:00","exception":false,"start_time":"2026-09-03T10:22:32.333942+00:00","status":"completed"},"tags":[]},"outputs":[{"data":{"image/png":"\n","text/plain":["<Figure size 1200x500 with 10 Axes>"]},"metadata":{},"output_type":"display_data"}],"source":["# compare original vs aligned+cropped for a few samples\n","plt.figure(figsize=(12, 5))\n","for i in range(5):\n","    plt.subplot(2, 5, i + 1)\n","    plt.imshow(raw_images[i])\n","    plt.title(\"Original\")\n","    plt.axis('off')\n","\n","    plt.subplot(2, 5, i + 6)\n","    plt.imshow(aligned_faces[i])\n","    plt.title(\"Aligned + cropped\")\n","   