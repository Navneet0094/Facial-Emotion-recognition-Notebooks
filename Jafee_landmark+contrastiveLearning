bels, subjects):\n","        clf = SVC(kernel='linear', probability=True) if classifier is None else classifier\n","        clf.fit(features[train_idx], labels[train_idx])\n","        y_pred[test_idx] = clf.predict(features[test_idx])\n","\n","    return y_pred\n","\n","y_pred_baseline = evaluate_subject_independent(X_hog_scaled, labels, subjects, n_splits=5)\n","\n","baseline_acc = accuracy_score(labels, y_pred_baseline)\n","baseline_f1 = f1_score(labels, y_pred_baseline, average='macro')\n","\n","print(f\"Baseline (raw HOG + SVM) — Accuracy: {baseline_acc:.4f}, Macro F1: {baseline_f1:.4f}\")\n"]},{"cell_type":"markdown","id":"59c9d743","metadata":{"papermill":{"duration":0.02022,"end_time":"2026-09-03T10:22:38.634663+00:00","exception":false,"start_time":"2026-09-03T10:22:38.614443+00:00","status":"completed"},"tags":[]},"source":["## Step 7 — Building Contrastive Pairs\n","\n","\n"]},{"cell_type":"code","execution_count":14,"id":"71c76ce6","metadata":{"execution":{"iopub.execute_input":"2026-09-03T10:22:38.677698Z","iopub.status.busy":"2026-09-03T10:22:38.677405Z","iopub.status.idle":"2026-09-03T10:22:38.684424Z","shell.execute_reply":"2026-09-03T10:22:38.683644Z"},"papermill":{"duration":0.030515,"end_time":"2026-09-03T10:22:38.686309+00:00","exception":false,"start_time":"2026-09-03T10:22:38.655794+00:00","status":"completed"},"tags":[]},"outputs":[],"source":["def make_pairs(features, labels, pairs_per_sample=6):\n","    pair_a, pair_b, pair_y = [], [], []\n","    idx_by_class = {c: np.where(labels == c)[0] for c in np.unique(labels)}\n","\n","    for i in range(len(labels)):\n","        cls = labels[i]\n","\n","        # positive pairs — same emotion\n","        for _ in range(pairs_per_sample // 2):\n","            j = np.random.choice(idx_by_class[cls])\n","            pair_a.append(i); pair_b.append(j); pair_y.append(1)\n","\n","        # negative pairs — different emotion\n","        other_classes = [c for c in idx_by_class if c != cls]\n","        for _ in range(pairs_per_sample // 2):\n","            neg_cls = np.random.choice(other_classes)\n","            j = np.random.choice(idx_by_class[neg_cls])\n","            pair_a.append(i); pair_b.append(j); pair_y.append(0)\n","\n","    return features[pair_a], features[pair_b], np.array(pair_y, dtype='float32')\n"]},{"cell_type":"markdown","id":"a7010dd9","metadata":{"papermill":{"duration":0.020442,"end_time":"2026-09-03T10:22:38.72633+00:00","exception":false,"start_time":"2026-09-03T10:22:38.705888+00:00","status":"completed"},"tags":[]},"source":["## Step 8 — Siamese Network + Contrastive Loss\n"]},{"cell_type":"code","execution_count":15,"id":"9029f8cc","metadata":{"execution":{"iopub.execute_input":"2026-09-03T10:22:38.767989Z","iopub.status.busy":"2026-09-03T10:22:38.76764Z","iopub.status.idle":"2026-09-03T10:22:38.776885Z","shell.execute_reply":"2026-09-03T10:22:38.776093Z"},"papermill":{"duration":0.032447,"end_time":"2026-09-03T10:22:38.778665+00:00","exception":false,"start_time":"2026-09-03T10:22:38.746218+00:00","status":"completed"},"tags":[]},"outputs":[],"source":["EMBEDDING_DIM = 32\n","MARGIN = 1.0\n","\n","def build_embedding_network(input_dim, embedding_dim=EMBEDDING_DIM):\n","    inp = layers.Input(shape=(input_dim,))\n","    x = layers.Dense(256, activation='relu')(inp)\n","    x = layers.Dropout(0.3)(x)\n","    x = layers.Dense(embedding_dim, activation=None)(x)\n","    x = layers.Lambda(lambda t: tf.math.l2_normalize(t, axis=1))(x)\n","    return Model(inp, x, name=\"embedding_net\")\n","\n","def contrastive_loss(margin=MARGIN):\n","    def loss(y_true, y_pred):\n","        y_true = tf.cast(y_true, y_pred.dtype)\n","        pos_term = y_true * tf.square(y_pred)\n","        neg_term = (1 - y_true) * tf.square(tf.maximum(margin - y_pred, 0))\n","        return tf.reduce_mean(pos_term + neg_term)\n","    return loss\n","\n","def build_siamese(input_dim):\n","    embedding_net = build_embedding_network(input_dim)\n","\n","    input_a = layers.Input(shape=(input_dim,))\n","    input_b = layers.Input(shape=(input_dim,))\n","    emb_a = embedding_net(input_a)\n","    emb_b = embedding_net(input_b)\n","\n","    distance = layers.Lambda(\n","        lambda e: tf.sqrt(tf.reduce_sum(tf.square(e[0] - e[1]), axis=1, keepdims=True) + 1e-9)\n","    )([emb_a, emb_b])\n","\n","    siamese_model = Model([input_a, input_b], distance)\n","    siamese_model.compile(optimizer='adam', loss=contrastive_loss())\n","    return siamese_model, embedding_net\n"]},{"cell_type":"code","execution_count":16,"id":"4ac9f369","metadata":{"execution":{"iopub.execute_input":"2026-09-03T10:22:38.821255Z","iopub.status.busy":"2026-09-03T10:22:38.820555Z","iopub.status.idle":"2026-09-03T10:24:39.192483Z","shell.execute_reply":"2026-09-03T10:24:39.191382Z"},"papermill":{"duration":120.395549,"end_time":"2026-09-03T10:24:39.19432+00:00","exception":false,"start_time":"2026-09-03T10:22:38.798771+00:00","status":"completed"},"tags":[]},"outputs":[{"name":"stderr","output_type":"stream","text":["2026-09-03 10:22:38.894747: E external/local_xla/xla/stream_executor/cuda/cuda_platform.cc:51] failed call to cuInit: INTERNAL: CUDA error: Failed call to cuInit: UNKNOWN ERROR (303)\n"]},{"name":"stdout","output_type":"stream","text":["Fold 1/5 — train=170, test=43, final loss=0.0049, accuracy=0.3953\n","Fold 2/5 — train=170, test=43, final loss=0.0063, accuracy=0.6279\n","Fold 3/5 — train=170, test=43, final loss=0.0067, accuracy=0.5581\n","Fold 4/5 — train=171, test=42, final loss=0.0059, accuracy=0.5238\n","Fold 5/5 — train=171, test=42, final loss=0.0058, accuracy=0.4286\n","\n","All folds done.\n"]}],"source":["N_SPLITS = 5\n","EPOCHS = 40\n","BATCH_SIZE = 32\n","\n","gkf = GroupKFold(n_splits=N_SPLITS)\n","\n","y_pred_contrastive = np.zeros_like(labels)\n","fold_histories = []\n","last_fold_embeddings = None  \n","for fold, (train_idx, test_idx) in enumerate(gkf.split(X_hog_scaled, labels, subjects)):\n","    X_train, X_test = X_hog_scaled[train_idx], X